{
  "name": "tangiz-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Бекенд TANGIZ — API для сайту та (згодом) Telegram-бота.",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "seed": "node --env-file=.env prisma/seed.js",
    "bot:check": "node --env-file=.env scripts/check-bot.js",
    "bot:setup": "node --env-file=.env scripts/setup-bot.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "grammy": "^1.45.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
